<Project Sdk="Microsoft.NET.Sdk">

  <!--
    桌面基线宿主：只在开发机上跑 MonoRuntimeProbe，用来验证探针代码本身正确。
    它的结果【不能】代表 Android 运行时（见 docs/audit/runtime-feasibility.md §2.2）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonoRuntimeProbe.Host</AssemblyName>
    <RootNamespace>MonoRuntimeProbe.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonoRuntimeProbe\MonoRuntimeProbe.csproj" />
  </ItemGroup>

</Project>
