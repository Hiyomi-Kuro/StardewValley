<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModFramework.Runtime - the mod host that Bootstrap loads from the Mods directory.

    It contains three things and nothing else:
      1) the public mod contract (IModEntry / IModContext / IModLogger),
      2) the manifest + dependency + discovery engine,
      3) the loader that turns mod packages into initialized mods.

    IMPORTANT (runtime constraint, see docs/architecture/phase1-runtime-constraints.md):
    this assembly is compiled against the game's own ILLink-trimmed assemblies
    (dotnet build -p:AndroidRefsDir=<dir>) because the shipped BCL is a subset.
    Do not use System.Linq, System.Text.Json, FileInfo/DirectoryInfo, Directory.GetFiles,
    Environment.CurrentDirectory or Version.TryParse here: they do not exist at runtime.

    The assembly identity and the framework API version are separate on purpose:

      AssemblyVersion stays 1.0.0.0 - it is the binding identity every existing mod was compiled
      against, and the preflight compares it when a mod ships its own runtime copy. Bumping it
      would change what old binaries bind to without adding any value.
      Version / FileVersion move to 1.1.0 - the API version that manifests are gated against
      (reported by Loader.FrameworkApiVersion).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModFramework.Runtime</AssemblyName>
    <RootNamespace>ModFramework.Runtime</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test host exercises the internal engine directly (manifest/version/graph). -->
    <InternalsVisibleTo Include="ModFramework.Tests" />
  </ItemGroup>

</Project>
