<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModFramework.Runtime 的最小版本（Phase 0 用）。
    它不是最终的 Loader —— 只做两件事：
      1) 在 Mods/ 目录写一份 loader.log，证明 Bootstrap 真的把它加载起来并执行了；
      2) 如果 Mods/ 里有 MonoRuntimeProbe.dll，就调用它的 Probe.Run()，产出运行时报告。

    真正的 Mod 加载（manifest 解析、依赖拓扑、事件总线）属于 Phase 1，
    在 E1/E2 通过前不实现。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModFramework.Runtime</AssemblyName>
    <RootNamespace>ModFramework.Runtime</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
