<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModInjector：构建期 IL 注入工具。

    职责：在 StardewValley.dll 里
      1) 新增 ModFramework.Bootstrap 类型（自包含，仅用 BCL），
      2) 在 StardewValley.MainActivity.OnCreatePartTwo 的首条指令前插入 call Bootstrap.Start()。

    为什么合并进游戏程序集而不是新增程序集：
    assemblies.blob 里除了条目表还有一张 65 条的 hash→(store,index) 映射表
    （40 字节/条，实测），新增条目必须同步改这张表与 libxamarin-app.so 的
    assembly_image_cache，风险远大于收益。合并进已有程序集则完全不动容器。
    见 docs/audit/adr-0001-mod-injection.md。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModInjector</AssemblyName>
    <RootNamespace>ModInjector</RootNamespace>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 2.0: the synthetic injector tests exercise the injection rules directly. -->
    <InternalsVisibleTo Include="InjectorTests" />
  </ItemGroup>

</Project>
