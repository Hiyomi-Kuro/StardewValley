<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop contract host for ModFramework.Runtime.Loader.Start().

    It does NOT represent the Android runtime (the trimmed BCL surface can only be
    checked on device). It checks the *control-flow contract* that Bootstrap relies on:
    a fully successful run must return null, and the diagnostic report must reach
    loader-report.txt so that a default build (whose catch handler swallows the
    exception) still leaves retrievable evidence.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoaderContract</AssemblyName>
    <RootNamespace>LoaderContract</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Mod\ModFramework.Runtime\ModFramework.Runtime.csproj" />
  </ItemGroup>

</Project>
