<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2.1-P prototype tests. Offline: the coordinator matrix plus a synthetic Cecil assembly
    that is patched, written, loaded and executed in this process.

    The optional target and verify-target switches run the layer-3 static check against a
    temporary copy. They do not build an APK and do not execute the game assembly.

    Nothing in the default build or CI references this project.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Phase21.PrototypeTests</AssemblyName>
    <RootNamespace>Phase21PrototypeTests</RootNamespace>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\prototype\WorldReady\Phase21.WorldReady.csproj" />
  </ItemGroup>

</Project>
