<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2.0 injector tests. Offline and game-free: every fixture is a synthetic Mono.Cecil
    module that is patched, written, loaded and executed in this process.

    This is deliberately not "one successful run against StardewValley.dll": multiple returns,
    branches straight to a ret, exception-handler boundaries, wrong signatures and partial
    patches are exactly the shapes that a single real method never exercises.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InjectorTests</AssemblyName>
    <RootNamespace>InjectorTests</RootNamespace>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ModInjector\ModInjector.csproj" />
  </ItemGroup>

</Project>
