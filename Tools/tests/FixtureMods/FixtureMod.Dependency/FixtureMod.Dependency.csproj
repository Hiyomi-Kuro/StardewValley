<Project Sdk="Microsoft.NET.Sdk">

  <!-- A private dependency of the fixture mod. It sits next to FixtureMod.dll inside the
       mod package, so the loader must resolve it through Assembly.LoadFrom's directory
       probing - it is never referenced by any manifest. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FixtureMod.Dependency</AssemblyName>
    <RootNamespace>FixtureMod.Dependency</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
