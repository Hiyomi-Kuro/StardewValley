<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2.1-P internal prototype. NOT part of the default toolchain.

    Nothing in Tools/ModInjector, Tools/build_modded_apk.py, the Gradle builds or the CI
    workflow references this project. It exists to test two things in isolation:

      1. a small, deterministic coordinator for "one successful world entry = one internal
         observation" (WorldReadyCoordinator.cs);
      2. a Cecil injector that can place the two candidate hooks on a synthetic fixture and,
         behind an explicit target switch, on a temporary copy of the real assembly
         (PrototypeInjector.cs).

    It deliberately does not add public mod API, does not change ModFramework.Runtime,
    Bootstrap, the loader-only build or the event build.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Phase21.WorldReady</AssemblyName>
    <RootNamespace>Phase21.WorldReady</RootNamespace>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
