# ---- 构建产物 ----
app/build/
build/
.gradle/
.kotlin/

# ---- 可随时整体删除的临时/垃圾目录 ----
.tmp/
.work/
base/
tools/

# 例外：Mod Framework 的工具源码要入库（历史遗留的 tools/ 仍然忽略）
!Tools/
!Tools/**

# ---- 第三方 jar（wrapper 例外）----
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ---- 签名材料（每台机器自己生成）----
*.keystore
*.jks

# ---- APK 产物 ----
*.apk

# ---- 本地说明文件（不入库）----
AGENTS.md

# ---- 系统与编辑器 ----
Thumbs.db
.DS_Store
.vscode/
.idea/
*.log

# ---- Python 缓存（Tools/ 下的脚本）----
__pycache__/
*.pyc

# ---- .NET 构建产物（Tools/ModInjector、Tools/tests/*）----
# obj/ 里是 NuGet 还原结果，含本机绝对路径与用户名，绝不能 audit/扫描时被当成源码。
bin/
obj/
